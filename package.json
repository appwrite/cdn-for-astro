{
  "name": "@appwrite.io/cdn-for-astro",
  "description": "Route caching for Astro sites hosted on Appwrite",
  "version": "1.0.0",
  "type": "module",
  "author": "Appwrite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appwrite/cdn-for-astro.git"
  },
  "keywords": [
    "appwrite",
    "astro",
    "astro-integration",
    "cache",
    "cdn"
  ],
  "bugs": "https://github.com/appwrite/cdn-for-astro/issues",
  "homepage": "https://github.com/appwrite/cdn-for-astro#readme",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./cache": "./dist/cache/index.js",
    "./cache/provider": "./dist/cache/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "package:check": "publint && attw --pack --profile esm-only",
    "changeset": "changeset",
    "version": "changeset version",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "node-appwrite": "^28.0.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.10.6",
    "astro": "^7.2.2",
    "lint-staged": "^16.2.7",
    "publint": "^0.3.14",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
