{
  "name": "@appwrite.io/cdn-for-astro",
  "description": "Route caching for Astro sites hosted on Appwrite",
  "version": "0.1.0",
  "type": "module",
  "author": "Appwrite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appwrite/cdn-for-astro.git"
  },
  "keywords": [
    "appwrite",
    "astro",
    "astro-integration",
    "cache",
    "cdn"
  ],
  "bugs": "https://github.com/appwrite/cdn-for-astro/issues",
  "homepage": "https://github.com/appwrite/cdn-for-astro#readme",
  "exports": {
    ".": "./dist/index.js",
    "./cache/provider": "./dist/cache/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "node-appwrite": "^28.0.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "astro": "^7.2.2",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
